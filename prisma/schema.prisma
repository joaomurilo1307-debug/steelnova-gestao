generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  ENGENHEIRO
  MESTRE_OBRA
  VISUALIZADOR
}

enum ObraStatus {
  PLANEJAMENTO
  EM_ANDAMENTO
  PAUSADA
  CONCLUIDA
}

enum TarefaStatus {
  A_FAZER
  FAZENDO
  BLOQUEADO
  FEITO
}

enum TarefaPrioridade {
  BAIXA
  MEDIA
  ALTA
  URGENTE
}

// FS = término→início (padrão), SS = início→início, FF = término→término, SF = início→término
enum TipoDependencia {
  FS
  SS
  FF
  SF
}

enum RaciPapel {
  R
  A
  C
  I
}

enum PropostaStatus {
  RASCUNHO
  ENVIADA
  EM_NEGOCIACAO
  APROVADA
  RECUSADA
  CONVERTIDA
}

enum RdoClima {
  SOL
  NUBLADO
  CHUVA
  TEMPO_RUIM
}

enum RdoSituacao {
  FINALIZADA
  PARCIAL
}

// Status de compra de cada material (aba Materiais). Alimenta o card "Compras necessárias".
enum StatusCompra {
  A_COMPRAR
  EM_COTACAO
  COMPRADO
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(VISUALIZADOR)
  active       Boolean  @default(true)
  avatarUrl    String?  @db.Text
  createdAt    DateTime @default(now())

  obras          ObraMembro[]
  tarefas        Tarefa[]         @relation("TarefaResponsavel")
  rdos           Rdo[]
  arquivos       Arquivo[]
  raciAtribuicoes RaciAtribuicao[]
  mensagens      ChatMensagem[]
  propostas      Proposta[]
  rotinas        Rotina[]
}

enum RotinaRecorrencia {
  DIARIA
  DIAS_UTEIS
  SEMANAL
  PONTUAL
}

// Tarefa de rotina/vida pessoal — não pertence a nenhuma Obra. Recriada "sozinha" a cada
// virada de dia: RotinaExecucao guarda só se ela foi concluída NAQUELE dia (@@unique
// [rotinaId,data]), então um dia novo automaticamente não tem execução ainda = pendente de
// novo, sem precisar de job/cron pra "resetar" nada.
model Rotina {
  id           String            @id @default(cuid())
  userId       String
  titulo       String
  descricao    String?
  duracaoMin   Int?
  recorrencia  RotinaRecorrencia @default(DIARIA)
  diasSemana   Int[]             @default([]) // 0=domingo...6=sábado, usado só quando SEMANAL
  ativo        Boolean           @default(true)
  ordem        Int               @default(0)
  createdAt    DateTime          @default(now())

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  execucoes RotinaExecucao[]
}

model RotinaExecucao {
  id           String   @id @default(cuid())
  rotinaId     String
  data         String   // yyyy-mm-dd (dia local do usuário, não UTC)
  concluida    Boolean  @default(false)
  concluidaEm  DateTime?

  rotina Rotina @relation(fields: [rotinaId], references: [id], onDelete: Cascade)

  @@unique([rotinaId, data])
}

model Obra {
  id                String     @id @default(cuid())
  nome              String
  cliente           String
  endereco          String?
  valorContrato     Decimal    @db.Decimal(14, 2)
  status            ObraStatus @default(PLANEJAMENTO)
  dataInicio        DateTime
  prazoPrevistoDias Int
  progresso         Int        @default(0)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  membros            ObraMembro[]
  tarefas            Tarefa[]
  rdos               Rdo[]
  custos             CustoLancamento[]
  materiais          Material[]
  arquivos           Arquivo[]
  parametrosOrcamento ParametrosOrcamento?
  servicosOrcamento  ServicoOrcamento[]
  lancamentosPonto   LancamentoPonto[]
  desembolsos        Desembolso[]
  mensagens          ChatMensagem[]
  proposta           Proposta?
  medicoes           Medicao[]
  custosIndiretos    CustoIndireto[]
  medicaoComponentes MedicaoComponente[]
}

// Medição física por componente (peso). % Fabricado e % Montado por grupo de material.
// Peso vem dos Materiais; o avanço é sugerido pelo Planejamento e ajustado aqui.
model MedicaoComponente {
  id           String  @id @default(cuid())
  obraId       String
  grupo        String
  pctFabricado Decimal @default(0) @db.Decimal(5, 2)
  pctMontado   Decimal @default(0) @db.Decimal(5, 2)

  obra Obra @relation(fields: [obraId], references: [id], onDelete: Cascade)

  @@unique([obraId, grupo])
}

// Aquisição / imobilizado (ex.: máquina). Dois papéis:
//  - COMPETÊNCIA: parcela mensal (valor/vidaUtilMeses) entra no rateio das obras ativas → resultado operacional.
//  - CAIXA: valor cheio na dataCompra → relatórios de lucro/caixa (o dinheiro saiu inteiro).
model Aquisicao {
  id            String   @id @default(cuid())
  descricao     String
  categoria     String   @default("Equipamento")
  valor         Decimal  @db.Decimal(14, 2)
  dataCompra    DateTime
  vidaUtilMeses Int      @default(24)
  createdAt     DateTime @default(now())
}

// Custo indireto (ex.: salário administrativo, aluguel). Rateado entre obras.
model CustoIndireto {
  id          String   @id @default(cuid())
  descricao   String
  categoria   String   @default("Salário")
  valor       Decimal  @db.Decimal(14, 2)
  competencia DateTime
  recorrente  Boolean  @default(false)
  escopo      String   @default("TODAS") // "TODAS" (ativas por horas) | "UMA" (obra específica)
  obraId      String?
  createdAt   DateTime @default(now())

  obra Obra? @relation(fields: [obraId], references: [id], onDelete: SetNull)
}

// Boletim de medição da obra — o executado que vira receita medida (base do resultado operacional).
model Medicao {
  id        String   @id @default(cuid())
  obraId    String
  numero    Int      @default(1)
  data      DateTime
  descricao String?
  valor     Decimal  @db.Decimal(14, 2)
  createdAt DateTime @default(now())

  obra Obra @relation(fields: [obraId], references: [id], onDelete: Cascade)
}

model ChatMensagem {
  id        String   @id @default(cuid())
  obraId    String
  autorId   String
  texto     String
  createdAt DateTime @default(now())

  obra  Obra @relation(fields: [obraId], references: [id], onDelete: Cascade)
  autor User @relation(fields: [autorId], references: [id])
}

model ObraMembro {
  id      String @id @default(cuid())
  obraId  String
  userId  String
  funcao  String

  obra Obra @relation(fields: [obraId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([obraId, userId])
}

model Tarefa {
  id                String            @id @default(cuid())
  obraId            String
  eap               String?
  fase              String?
  titulo            String
  descricao         String?
  status            TarefaStatus      @default(A_FAZER)
  prioridade        TarefaPrioridade  @default(MEDIA)
  dataInicio        DateTime?
  duracaoDias       Int               @default(1)
  percentConcluido  Int               @default(0)
  dataInicioReal    DateTime?
  dataFimReal       DateTime?
  pessoas           Int?
  horas             Decimal?          @db.Decimal(6, 2)
  turno             String?
  responsavelNome   String?
  observacoes       String?
  ordem             Int               @default(0)
  responsavelId     String?
  predecessoraId    String?
  tarefaMaeId       String?
  horasEstimadas    Decimal?          @db.Decimal(8, 2)
  valorHora         Decimal?          @db.Decimal(10, 2)
  // Equipe de campo (Funcionario) alocada nesta atividade — separado do responsavelId
  // (que é o sócio/User responsável). Serve pra puxar horas reais batidas no Ponto/RDO
  // por essas pessoas dentro da janela da tarefa, sem redigitar nada.
  equipeIds         String[]          @default([])
  // Vínculo opcional com o serviço do Orçamento que essa tarefa executa (ex.: tarefas de
  // solda/montagem de tesoura → serviço "B · Montagem"). Permite a Medição sugerir o %
  // concluído de cada serviço a partir do progresso real do Planejamento, sem redigitar.
  servicoOrcamentoId String?

  obra             Obra              @relation(fields: [obraId], references: [id], onDelete: Cascade)
  responsavel      User?             @relation("TarefaResponsavel", fields: [responsavelId], references: [id])
  predecessora     Tarefa?           @relation("TarefaPredecessora", fields: [predecessoraId], references: [id])
  sucessoras       Tarefa[]          @relation("TarefaPredecessora")
  tarefaMae        Tarefa?           @relation("TarefaSubtarefas", fields: [tarefaMaeId], references: [id], onDelete: Cascade)
  subtarefas       Tarefa[]          @relation("TarefaSubtarefas")
  servicoOrcamento ServicoOrcamento? @relation(fields: [servicoOrcamentoId], references: [id], onDelete: SetNull)

  // rede de dependências pra CPM de verdade (caminho crítico) — permite várias predecessoras por
  // tarefa, com tipo (FS/SS/FF/SF) e lag em dias, igual ao consominas. O predecessoraId acima é
  // mantido só por compatibilidade com dado antigo; o cálculo de folga/crítico passa a usar isto.
  dependenciasComoSucessora    TarefaDependencia[] @relation("DependenciaSucessora")
  dependenciasComoPredecessora TarefaDependencia[] @relation("DependenciaPredecessora")
  rdoAtividades                RdoAtividade[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TarefaDependencia {
  id             String          @id @default(cuid())
  predecessoraId String
  sucessoraId    String
  tipo           TipoDependencia @default(FS)
  lagDias        Int             @default(0)

  predecessora Tarefa @relation("DependenciaPredecessora", fields: [predecessoraId], references: [id], onDelete: Cascade)
  sucessora    Tarefa @relation("DependenciaSucessora", fields: [sucessoraId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([predecessoraId, sucessoraId])
}

model Rdo {
  id                 String      @id @default(cuid())
  obraId             String
  data               DateTime
  clima              RdoClima    @default(SOL)
  horarioInicio      String?
  horarioTermino     String?
  houveParalisacao   Boolean     @default(false)
  horarioParalisacao String?
  motivoParalisacao  String?
  observacoes        String?
  autorId            String
  createdAt          DateTime    @default(now())

  obra          Obra             @relation(fields: [obraId], references: [id], onDelete: Cascade)
  autor         User             @relation(fields: [autorId], references: [id])
  fotos         RdoFoto[]
  trabalhadores RdoTrabalhador[]
  atividades    RdoAtividade[]
  pendencias    RdoPendencia[]

  @@unique([obraId, data])
}

model RdoTrabalhador {
  id      String @id @default(cuid())
  rdoId   String
  nome    String
  funcao  String
  entrada String?
  saida   String?

  rdo Rdo @relation(fields: [rdoId], references: [id], onDelete: Cascade)
}

model RdoAtividade {
  id        String      @id @default(cuid())
  rdoId     String
  descricao String
  situacao  RdoSituacao @default(PARCIAL)
  // Liga a atividade do dia a um item real do Planejamento (opcional — permite
  // digitar livre quando não houver correspondência). SetNull: apagar a tarefa
  // não some com o histórico do RDO.
  tarefaId  String?

  rdo    Rdo     @relation(fields: [rdoId], references: [id], onDelete: Cascade)
  tarefa Tarefa? @relation(fields: [tarefaId], references: [id], onDelete: SetNull)
}

model RdoPendencia {
  id         String  @id @default(cuid())
  rdoId      String
  descricao  String
  observacao String?

  rdo Rdo @relation(fields: [rdoId], references: [id], onDelete: Cascade)
}

model RdoFoto {
  id      String @id @default(cuid())
  rdoId   String
  url     String
  legenda String?

  rdo Rdo @relation(fields: [rdoId], references: [id], onDelete: Cascade)
}

model Material {
  id                   String   @id @default(cuid())
  obraId               String
  grupo                String?
  nome                 String
  unidade              String
  quantidadePrevista   Decimal  @db.Decimal(14, 2)
  quantidadeRecebida   Decimal  @default(0) @db.Decimal(14, 2)
  fornecedor           String?
  custoUnitario        Decimal? @db.Decimal(14, 2)
  pesoUnitario         Decimal? @db.Decimal(12, 3)
  fornecidoPeloCliente Boolean  @default(false)
  statusCompra         StatusCompra @default(A_COMPRAR)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  obra Obra @relation(fields: [obraId], references: [id], onDelete: Cascade)
}

model ParametrosOrcamento {
  id                 String  @id @default(cuid())
  obraId             String  @unique
  maoDeObraPorKg     Decimal @default(0) @db.Decimal(10, 2)
  insumosPorKg       Decimal @default(0) @db.Decimal(10, 2)
  bdiPercent         Decimal @default(0.30) @db.Decimal(6, 4)
  instalacaoPorM2    Decimal @default(0) @db.Decimal(10, 2)
  valorAlvo          Decimal? @db.Decimal(14, 2)
  diariaPadrao       Decimal @default(150) @db.Decimal(10, 2)
  horasPorDiaria     Decimal @default(8) @db.Decimal(4, 1)
  encarregadoFixo    Decimal @default(0) @db.Decimal(10, 2)
  alimentacaoPorDia  Decimal @default(0) @db.Decimal(10, 2)
  impostoPercent     Decimal @default(0.06) @db.Decimal(6, 4)

  obra Obra @relation(fields: [obraId], references: [id], onDelete: Cascade)
}

model ServicoOrcamento {
  id              String  @id @default(cuid())
  obraId          String
  nome            String
  baseQtd         Decimal @db.Decimal(12, 3)
  unidade         String
  materiaPrima    Decimal @default(0) @db.Decimal(12, 2)
  insumosManual   Decimal? @db.Decimal(12, 2)
  maoDeObraManual Decimal? @db.Decimal(12, 2)
  bdiManual       Decimal? @db.Decimal(12, 2)
  ordem           Int     @default(0)
  createdAt       DateTime @default(now())

  obra    Obra     @relation(fields: [obraId], references: [id], onDelete: Cascade)
  tarefas Tarefa[]
}

model Funcionario {
  id           String  @id @default(cuid())
  nome         String
  cargo        String?
  regime       String  @default("Diaria")
  diariaPadrao Decimal? @db.Decimal(10, 2)
  valorFixo    Decimal? @db.Decimal(10, 2)
  active       Boolean @default(true)

  lancamentos    LancamentoPonto[]
  desembolsosRef Desembolso[] @relation("DesembolsoFuncionario")
}

model LancamentoPonto {
  id            String   @id @default(cuid())
  obraId        String
  funcionarioId String
  dia           DateTime
  entrada       String
  saida         String
  createdAt     DateTime @default(now())

  obra        Obra        @relation(fields: [obraId], references: [id], onDelete: Cascade)
  funcionario Funcionario @relation(fields: [funcionarioId], references: [id])
}

model Desembolso {
  id                String    @id @default(cuid())
  obraId            String
  pessoa            String
  item              String
  categoria         String
  valor             Decimal   @db.Decimal(10, 2)
  data              DateTime?
  funcionarioRefId  String?

  obra           Obra         @relation(fields: [obraId], references: [id], onDelete: Cascade)
  funcionarioRef Funcionario? @relation("DesembolsoFuncionario", fields: [funcionarioRefId], references: [id])
}

model LancamentoFinanceiro {
  id        String   @id @default(cuid())
  tipo      String
  descricao String
  pessoa    String?
  valor     Decimal  @db.Decimal(12, 2)
  data      DateTime
  createdAt DateTime @default(now())
}

enum ArquivoCategoria {
  NOTA_FISCAL
  PLANILHA_HORARIOS
  PROJETO
  FOTO
  OUTRO
}

model Arquivo {
  id             String           @id @default(cuid())
  obraId         String
  nome           String
  categoria      ArquivoCategoria @default(OUTRO)
  url            String
  tamanho        Int
  valor          Decimal?         @db.Decimal(12, 2)
  descricao      String?
  data           DateTime?
  uploadadoPorId String
  createdAt      DateTime         @default(now())

  obra         Obra @relation(fields: [obraId], references: [id], onDelete: Cascade)
  uploadadoPor User @relation(fields: [uploadadoPorId], references: [id])
}

model CustoLancamento {
  id              String   @id @default(cuid())
  obraId          String
  categoria       String
  tipo            String   @default("Direto") // "Direto" | "Indireto" — para relatórios
  descricao       String
  valorPrevisto   Decimal  @db.Decimal(14, 2)
  valorRealizado  Decimal? @db.Decimal(14, 2)
  data            DateTime
  createdAt       DateTime @default(now())

  obra Obra @relation(fields: [obraId], references: [id], onDelete: Cascade)
}

model Processo {
  id     String @id @default(cuid())
  nome   String
  area   String

  atribuicoes RaciAtribuicao[]
}

model Proposta {
  id             String         @id @default(cuid())
  cliente        String
  contato        String?
  segmento       String?
  escopo         String
  valor          Decimal?       @db.Decimal(14, 2)
  custoEstimado  Decimal?       @db.Decimal(14, 2)
  custoGasto     Decimal?       @db.Decimal(14, 2) // valor investido pra ganhar a proposta (visita, projeto, deslocamento)
  status         PropostaStatus @default(RASCUNHO)
  dataEnvio      DateTime?
  validade       DateTime?
  // Período estimado do contrato (antes de virar Obra de verdade). Uma vez convertida
  // (obraId setado), o período real/projetado passa a vir da curva S da Obra — estes dois
  // campos ficam só como a estimativa original da proposta, pra comparar depois.
  dataInicioPrevista DateTime?
  prazoDiasContrato  Int?
  observacoes    String?
  motivoPerda    String?
  responsavelId  String?
  obraId         String?        @unique
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  responsavel User?              @relation(fields: [responsavelId], references: [id])
  obra        Obra?              @relation(fields: [obraId], references: [id], onDelete: SetNull)
  arquivos    PropostaArquivo[]
}

model PropostaArquivo {
  id         String   @id @default(cuid())
  propostaId String
  nome       String
  url        String
  tamanho    Int
  createdAt  DateTime @default(now())

  proposta Proposta @relation(fields: [propostaId], references: [id], onDelete: Cascade)
}

model RaciAtribuicao {
  id         String    @id @default(cuid())
  processoId String
  userId     String
  papel      RaciPapel

  processo Processo @relation(fields: [processoId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([processoId, userId, papel])
}
